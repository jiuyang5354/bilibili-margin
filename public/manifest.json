{
  "manifest_version": 3,
  "name": "映间 MARGIN",
  "short_name": "MARGIN",
  "version": "0.28.0",
  "description": "重新设计的 B 站首页、播放页、搜索页与其他页面：安静的排版、干净的推荐流。",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://search.bilibili.com/*",
        "https://space.bilibili.com/*",
        "https://t.bilibili.com/*",
        "https://message.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "flux.js"
      ],
      "matches": [
        "https://*.bilibili.com/*"
      ]
    }
  ]
}
