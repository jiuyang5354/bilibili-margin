{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "short_name": "MARGIN",
  "version": "0.60.55",
  "version_name": "0.6.55",
  "minimum_chrome_version": "110",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self' https://app.bilibili.com https://bsbsb.top https://api.github.com https://ipwho.is https://api.open-meteo.com https://geocoding-api.open-meteo.com"
  },
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.bilibili.com/*",
    "https://bsbsb.top/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://t.bilibili.com/*",
        "https://space.bilibili.com/*"
      ],
      "js": [
        "comment-location.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://search.bilibili.com/*",
        "https://space.bilibili.com/*",
        "https://t.bilibili.com/*",
        "https://message.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/bangumi/play/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/festival/*",
        "https://www.bilibili.com/cheese/play/*"
      ],
      "js": [
        "cdn.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "flux.js",
        "pages/*"
      ],
      "matches": [
        "https://*.bilibili.com/*"
      ]
    }
  ]
}
