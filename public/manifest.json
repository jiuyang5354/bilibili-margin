{
  "manifest_version": 3,
  "name": "映间 MARGIN",
  "short_name": "MARGIN",
  "version": "0.3.5",
  "description": "重新设计的 B 站首页：安静的排版、干净的推荐流。",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["https://www.bilibili.com/*"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
